# GEMINI_API_KEY: Required for Gemini AI API calls (/api/ai/analyze-health).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Aiven PostgreSQL Connection URI
# Thêm biến này vào cả .env (local) và Vercel -> Project Settings -> Environment Variables
DATABASE_URL="postgres://avnadmin:YOUR_AIVEN_PASSWORD@pg-xxxx.e.aivencloud.com:21684/defaultdb?sslmode=require"

# VITE_API_BASE_URL: Leave empty when frontend and backend run together on Vercel or localhost.
# VITE_API_BASE_URL=""
